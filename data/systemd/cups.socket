[Unit]
Description=CUPS Scheduler
PartOf=cups.service

[Socket]
ListenStream=/run/cups/cups.sock
SocketMode=0666
SocketUser=root
SocketGroup=lp
DirectoryMode=0755
# Loopback-only by default so installing Yindle never silently exposes port
# 631 to the LAN. To accept remote IPP connections, add a systemd drop-in
# (`systemctl edit cups.socket`) that clears ListenStream= and sets your bind
# address explicitly.
ListenStream=127.0.0.1:631
ListenStream=[::1]:631
ReusePort=true

[Install]
WantedBy=sockets.target
