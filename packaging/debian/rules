#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_build:
	cargo build --workspace --release --frozen

override_dh_auto_install:
	$(MAKE) install-files DESTDIR=$(CURDIR)/debian/presswork PROFILE=release CHOWN=0

override_dh_auto_test:
	# The conformance suite runs against a live daemon; run unit tests only.
	cargo test --workspace --release --frozen

override_dh_installsystemd:
	dh_installsystemd --name=cups
