# Maintainer: vindeckyy <35399491+vindeckyy@users.noreply.github.com>
pkgname=yindle-bin
pkgver=0.1.1
pkgrel=1
pkgdesc="Memory-safe CUPS 2.x-compatible print spooler and IPP scheduler in Rust (prebuilt release binaries)"
arch=('x86_64')
url="https://github.com/vindeckyy/yindle"
license=('Apache-2.0 OR MIT')
# Uses Arch's native libxcrypt (libcrypt.so.2 resolved dynamically via dlopen;
# libxcrypt-compat is not required).
depends=('glibc' 'gcc-libs' 'libxcrypt')
optdepends=(
    'cups-filters: PDF, PostScript, and raster conversion filters for legacy printers'
    'cups-client: lp, lpstat, and lpadmin command-line client tools'
)
provides=('cups' 'yindle')
conflicts=('cups' 'yindle')
backup=(
    'etc/cups/cupsd.conf'
    'etc/cups/cups-files.conf'
    'etc/cups/printers.conf'
    'etc/pam.d/cups'
    'etc/logrotate.d/yindle'
)
source=("https://github.com/vindeckyy/yindle/releases/download/v${pkgver}/yindle-${pkgver}-x86_64-unknown-linux-gnu.tar.gz"
        "yindle.sysusers"
        "yindle.tmpfiles")
# Update the first entry from the GitHub release SHA256SUMS asset (or run `updpkgsums`)
# whenever cutting a new release.
sha256sums=('9c64055af60297f9990a356a7e98d3ad4aafb0b07d38ac25bcb8e132d80a1ba8'
            '2e7921950685638c585f72276cf38e98eae6bd4eecf926fadcb4279af1bae3f0'
            'db6185fc34a36813a185074645b0356756d659d0ddbd393e6de39d5158415a00')

package() {
    cd "yindle-${pkgver}"

    # The release tarball is an FHS tree; install persistent system paths.
    # Runtime /run/cups and state dirs are managed by systemd-tmpfiles.
    cp -a usr etc "$pkgdir/"

    install -Dm644 "$srcdir/yindle.sysusers" \
        "$pkgdir/usr/lib/sysusers.d/yindle.conf"
    install -Dm644 "$srcdir/yindle.tmpfiles" \
        "$pkgdir/usr/lib/tmpfiles.d/yindle.conf"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    [ -f LICENSE-MIT ] && install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/MIT"
    [ -f LICENSE-APACHE ] && install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/Apache-2.0"
}
